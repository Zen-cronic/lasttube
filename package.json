{
  "name": "lasttube",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Resolve every discontinued-shade candidate and unlock an observed offer only when structured variant and visual evidence are complete.",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "proof:serpapi": "tsx scripts/proof-serpapi.ts",
    "proof:perfectcorp": "tsx scripts/proof-perfectcorp.ts",
    "proof:alternate-model": "tsx scripts/record-alternate-model-demo.ts",
    "scan:secrets": "tsx scripts/scan-secrets.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run scan:secrets",
    "capture:demo": "tsx scripts/capture-demo.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "hono": "^4.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "playwright-core": "^1.62.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
